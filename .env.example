# San As CRM - Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Configuration (Optional - Local SQLite fallback enabled by default)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Session Security Secret
SANAS_AUTH_SECRET=your-random-cryptographic-secret-key-32-chars-minimum
